#!/usr/bin/make -f

export GO111MODULE=on
export GOPROXY=https://goproxy.cn,direct
export GOCACHE=/tmp/go-cache
export GOMODCACHE=/tmp/go-modcache
export HOME=/tmp/go-home

MAN_DIR := $(CURDIR)/debian/manpages

%:
	dh $@ --buildsystem=golang --with=golang

override_dh_auto_build:
	go build -ldflags="-s -w" -o ag-cli ./cmd/ag-cli

override_dh_auto_install:
	install -Dm755 ag-cli $(CURDIR)/debian/atomgit-cli/usr/bin/ag-cli

override_dh_installman:
	mkdir -p $(CURDIR)/debian/atomgit-cli/usr/share/man/man1
	cp $(MAN_DIR)/*.1 $(CURDIR)/debian/atomgit-cli/usr/share/man/man1/
	dh_installman

override_dh_auto_clean:
	dh_auto_clean
	rm -rf debian/atomgit-cli
	rm -f ag-cli

override_dh_auto_test:
	@echo "Skipping tests for build"

override_dh_golang:
	@echo "Skipping dh_golang"